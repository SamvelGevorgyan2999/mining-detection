# Copy to .env and adjust. Every value has a working default, so an empty
# .env still runs against a local SQLite file.

# --- storage -----------------------------------------------------------
# Leave unset for SQLite (./miningguard.db). PostgreSQL example:
# MG_DATABASE_URL=postgresql+psycopg://miningguard:miningguard@localhost:5432/miningguard
MG_DATABASE_URL=

# --- api ---------------------------------------------------------------
MG_API_HOST=127.0.0.1
MG_API_PORT=8000
# URL the collector reports to.
MG_API_URL=http://127.0.0.1:8000
# Shared secret for the agent ingest endpoint. Empty disables the check.
MG_API_TOKEN=

# --- collector ---------------------------------------------------------
MG_COLLECTOR_INTERVAL=15
MG_COLLECTOR_TOP_PROCESSES=40
MG_RESOLVE_HOSTNAMES=yes
MG_GPU_SAMPLING=yes

# --- detection thresholds ---------------------------------------------
MG_SUSTAINED_CPU_PERCENT=80
MG_SUSTAINED_CPU_SECONDS=180
MG_ELEVATED_CPU_PERCENT=55
MG_SUSTAINED_GPU_PERCENT=75
MG_LONG_LIVED_CONNECTION_SECONDS=300
MG_BROWSER_CPU_PERCENT=45

# --- optional reputation feed -----------------------------------------
# MG_FEED_PATH=feeds/indicators.json
MG_FEED_PATH=

# --- retention ---------------------------------------------------------
MG_RETENTION_DAYS=14


